# ── Step-runtime feature flag ──
# Set to "true" ONLY in preview/staging. Default: false → legacy path runs unchanged.
# STEP_RUNTIME=false

# Supabase Auth & Site URL
# Production: set to your production domain
NEXT_PUBLIC_SITE_URL=https://airesumetailor.com

# For Vercel preview deployments: add NEXT_PUBLIC_VERCEL_URL=$VERCEL_URL in Vercel project settings
# Vercel auto-sets VERCEL_URL; this makes it available client-side for auth redirects
# NEXT_PUBLIC_VERCEL_URL=

# Google Search Console: paste the verification string from GSC (Settings > Ownership verification)
# GOOGLE_SITE_VERIFICATION=

# Cron jobs: set in Vercel for /api/cron/* endpoints. Min 16 chars, random string.
# CRON_SECRET=

# ── AI Providers ──
# TypeSafe AI Jev System 1 Model (Set in Vercel Project Settings > Environment Variables for production/preview)
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

