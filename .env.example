# ── Step-runtime feature flag ──
# Set to "true" ONLY in preview/staging. Default: false → legacy path runs unchanged.
# STEP_RUNTIME=false

# Supabase Auth & Site URL
# Production: set to your production domain
NEXT_PUBLIC_SITE_URL=https://airesumetailor.com

# For Vercel preview deployments: add NEXT_PUBLIC_VERCEL_URL=$VERCEL_URL in Vercel project settings
# Vercel auto-sets VERCEL_URL; this makes it available client-side for auth redirects
# NEXT_PUBLIC_VERCEL_URL=

# Google Search Console: paste the verification string from GSC (Settings > Ownership verification)
# GOOGLE_SITE_VERIFICATION=

# Cron jobs: set in Vercel for /api/cron/* endpoints. Min 16 chars, random string.
# CRON_SECRET=

# ── AI Providers ──
# TypeSafe AI Jev System 1 Model (Set in Vercel Project Settings > Environment Variables for production/preview)
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# ── LLM Observability (Langfuse) ──
# OPTIONAL. Tracing is a STRICT NO-OP until BOTH keys are present, so the app behaves
# identically without them and this can be enabled at any time.
#
# Create a free project at https://cloud.langfuse.com (Hobby: 50k units/mo, 30-day
# retention, full API on free), then copy the keys from that project's
# Settings -> API Keys. Set them in Vercel as environment variables — NOT in this file.
#
# IMPORTANT: the domain-owning Vercel project is the one whose Settings -> Domains lists
# airesumetailor.com. A second project is attached to this repo; vars set there do nothing
# for production. Env changes only apply to NEW deployments — redeploy after saving.
#
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST defaults to https://cloud.langfuse.com; set it only for self-hosting.
# LANGFUSE_HOST=


